# Names only. Real values live in Railway Variables / Supabase — never in git.

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only. Must never reach the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider (server only) ---
# openai | anthropic | mock
AI_PROVIDER=openai
# Model id for the chosen provider (no default on purpose: set it explicitly).
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: OpenAI-compatible endpoint for other providers.
OPENAI_BASE_URL=

# --- App ---
APP_ENV=staging
