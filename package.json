{
  "name": "ew-verdora-agent-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test packages/core/test/*.test.ts",
    "test:db": "bash scripts/test-db.sh",
    "test:kyc": "node --test scripts/agent-kyc-security.test.mjs",
    "simulate": "tsx packages/core/src/sim/run.ts",
    "check": "npm run typecheck && npm test && npm run test:kyc"
  },
  "dependencies": {
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
